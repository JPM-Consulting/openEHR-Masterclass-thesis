                                                <term_definitions code="at0000">
                                                    <items id="text">EoC Relationships entry</items>
                                                    <items id="description">CLUSTER within a clinical COMPOSITION on ENTRY level (OBSERVATION, EVALUATION, INSTRUCTION, ACTION) with associations for an episode-oriented medical record.</items>
                                                    <items id="comment">Placed under ENTRY.protocol.</items>
                                                </term_definitions>
                                                <term_definitions code="at0001">
                                                    <items id="text">Contact reference</items>
                                                    <items id="description">Reference from clinical COMPOSITION on ENTRY level to the care-encounter COMPOSITION (Contact).</items>
                                                    <items id="comment">Meaning = documents
Type = care encounter / contact</items>
                                                </term_definitions>
                                                <term_definitions code="at0003">
                                                    <items id="text">Assignments</items>
                                                    <items id="description"></items>
