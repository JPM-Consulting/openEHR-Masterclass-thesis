                                                <term_definitions code="at0154">
                                                    <items id="text">Primary</items>
                                                    <items id="description">The Episode of Care representing the primary Health Problem to which the clinical ENTRY is associated.</items>
                                                </term_definitions>
                                                <term_definitions code="at0155">
                                                    <items id="text">Associated</items>
                                                    <items id="description">An additional Episode of Care to which the clinical ENTRY is clinically relevant.</items>
