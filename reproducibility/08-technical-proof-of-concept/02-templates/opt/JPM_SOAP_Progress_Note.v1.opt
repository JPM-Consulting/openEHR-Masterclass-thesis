                </archetype_id>
                <term_definitions code="at0000">
                    <items id="text">SOAP headings</items>
                    <items id="description">Acronym for a group of headings used to aid recording of consistent, problem-oriented notes in a patient's health record.</items>
                </term_definitions>
                <term_definitions code="at0001">
                    <items id="text">Subjective (S)</items>
                    <items id="description">The subjective component, usually focused on the presenting complaint, history of present illness, relevant medical history and review of system.</items>
                    <items id="comment">For example: EVALUATION.reason_for_encounter and OBSERVATION.story.</items>
                </term_definitions>
                <term_definitions code="at0002">
                    <items id="text">Objective (O)</items>
                    <items id="description">The objective component, usually focused on observations, measurements, examination findings and diagnostic test results.</items>
                    <items id="comment">For example: OBSERVATION.exam, OBSERVATION.blood_pressure and OBSERVATION.laboratory_test_result.</items>
                </term_definitions>
                <term_definitions code="at0003">
                    <items id="text">Assessment (A)</items>
                    <items id="description">The assessment component, usually focused on conclusions and synopses about progress or change.</items>
                    <items id="comment">For example: EVALUATION.differential_diagnoses, EVALUATION.problem_diagnosis, and EVALUATION.clinical_synopsis.</items>
                </term_definitions>
                <term_definitions code="at0004">
                    <items id="text">Plan (P)</items>
                    <items id="description">The plan component, usually focused on future investigations and treatment, goals of therapy and monitoring.</items>
                    <items id="comment">For example: INSTRUCTION.service_request, INSTRUCTION.medication_order, and INSTRUCTION.health_education_request.</items>
                </term_definitions>
            </children>
