                    <items id="text">Tree</items>
                    <items id="description">@ internal @</items>
                </term_definitions>
                <term_definitions code="at0030">
                    <items id="text">Comment</items>
                    <items id="description">Narrative about the urinalysis not captured in other fields.</items>
                    <items id="comment">For example: the freshness or small volume of the urine sample, method of collection or any problems with testing.</items>
                </term_definitions>
